{
  "name": "opencode-mission-control",
  "version": "0.1.0",
  "description": "OpenCode plugin for parallel AI coding sessions in isolated git worktrees",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts",
    "./rpc": "./src/rpc.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "bun build ./src/index.ts ./src/tui.ts ./src/rpc.ts --outdir ./dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel",
    "release": "semantic-release",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@opencode/client": "^2.2.5",
    "@opencode/plugin": "^2.2.5",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "semantic-release": "^25.0.3",
    "solid-js": "^1.9.0",
    "typescript": "^5.0.0"
  },
  "author": "Nigel Bazzeghin <nbazzeghin@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/nigel-dev/opencode-mission-control#readme",
  "bugs": {
    "url": "https://github.com/nigel-dev/opencode-mission-control/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "worktree",
    "tmux",
    "parallel",
    "ai-coding",
    "git"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nigel-dev/opencode-mission-control"
  }
}
