{
  "name": "opencode-mission-control",
  "version": "0.1.0",
  "description": "OpenCode plugin for parallel AI coding sessions in isolated git worktrees",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts ./src/rpc.ts --outdir ./dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel",
    "release": "semantic-release"
  },
  "dependencies": {
    "@opencode/client": "^2.3.0",
    "@opencode/plugin": "^2.3.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.4",
    "@opentui/solid": ">=0.8.4",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/theme": "2.4.2",
    "@opentui/core": "0.9.9",
    "@opentui/solid": "0.9.9",
    "@types/bun": "latest",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "semantic-release": "^25.0.3",
    "solid-js": "^1.9.0",
    "typescript": "^5.0.0"
  },
  "author": "Nigel Bazzeghin <nbazzeghin@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/nigel-dev/opencode-mission-control#readme",
  "bugs": {
    "url": "https://github.com/nigel-dev/opencode-mission-control/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "worktree",
    "parallel",
    "ai-coding",
    "git",
    "orchestration",
    "merge-train"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nigel-dev/opencode-mission-control"
  }
}
